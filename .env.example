# -----------------------------------------------------------------------
# Notification Service — Environment Variables
# Copy this file to .env and fill in the values for your environment.
# -----------------------------------------------------------------------

# OAuth2 / JWT
# URL of the JWKS endpoint on your authorization server.
# Example: Keycloak running locally on port 9000.
JWT_JWK_SET_URI=http://localhost:9000/oauth2/jwks

# Kafka
# Bootstrap servers for the Kafka broker.
# Matches the PLAINTEXT_HOST listener in docker-compose.yml.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# PostgreSQL datasource
# Must match the POSTGRES_* variables in docker-compose.yml.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/notification_db
SPRING_DATASOURCE_USERNAME=notification
SPRING_DATASOURCE_PASSWORD=notification

# Spring profile
# Used to select the active configuration profile.
# Options: local | dev | staging | prod
SPRING_PROFILES_ACTIVE=local
